	"item": [
		{
			"name": "[POST] Create document",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const id = pm.response.json()._id;",
							"pm.collectionVariables.set(\"id\", id);",
							"",
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"",
							"const jsonRequest = JSON.parse(pm.request.body.raw);",
							"",
							"pm.test(\"Attributes created properly\", function () {",
							"    var jsonData = pm.response.json();",
							"",
							"    pm.expect(jsonData._id).to.not.eq(null);",
							"    pm.expect(jsonData.name).to.eql(jsonRequest.name);",
							"    pm.expect(jsonData.age).to.eql(jsonRequest.age);",
							"    pm.expect(jsonData.email).to.eql(jsonRequest.email);",
							"    pm.expect(jsonData.createdAt).to.not.eql(null);",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.collectionVariables.set(\"randomFirstName\",pm.collectionVariables.replaceIn(\"{{$randomFirstName}}\"))",
							"pm.collectionVariables.set(\"randomEmail\",pm.collectionVariables.replaceIn(\"{{$randomEmail}}\"))",
							"pm.collectionVariables.set(\"randomAge\", _.random(18, 99));"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"{{randomFirstName}}\",\n    \"email\": \"{{randomEmail}}\",\n    \"age\": {{randomAge}}\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}{{collection}}",
					"host": [
						"{{baseUrl}}{{collection}}"
					]
				}
			},
			"response": []
		},
